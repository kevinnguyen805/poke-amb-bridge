{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/share", "destination": "/api/share" },
    { "source": "/amb/ingress", "destination": "/api/amb/ingress" },
    { "source": "/healthz", "destination": "/api/healthz" },
    { "source": "/vcard", "destination": "/api/vcard" },
    { "source": "/open", "destination": "/api/open" },
    { "source": "/wallet", "destination": "/api/wallet" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/links/ingest", "destination": "/api/links/ingest" }
  ],
  "headers": [
    {
      "source": "/save-to-poke.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-as-shortcut" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Save to Poke.shortcut\"" }
      ]
    }
  ]
}
